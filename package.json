{
  "name": "agent-warcraft",
  "version": "0.1.0",
  "description": "Warcraft peon sound notifications for coding agents: Work complete!",
  "type": "module",
  "bin": {
    "agent-warcraft": "scripts/warcraft.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check scripts/warcraft.mjs && node --check scripts/pet.mjs && node --check scripts/build-site.mjs && node --check site/app.js && node --check site/theme.js && node --check scripts/build-gemini.mjs && node --check scripts/check-package.mjs && node scripts/check-project.mjs",
    "doctor": "node scripts/warcraft.mjs doctor",
    "site": "node scripts/build-site.mjs",
    "gemini": "node scripts/build-gemini.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "files": [
    "scripts/warcraft.mjs",
    "scripts/pet.mjs",
    "audio",
    "pets",
    "plugin.json",
    ".claude-plugin",
    ".agents/plugins",
    "hooks",
    "docs",
    "CHANGELOG.md",
    "assets/previews/banner.png",
    "assets/previews/orc-ready.gif",
    "assets/previews/orc-work-complete.gif",
    "assets/previews/orc-need-more-gold.gif",
    "assets/previews/orc-under-attack.gif",
    "assets/previews/orc-not-that-kind-of-orc.gif",
    "assets/previews/human-jobs-done.gif",
    "skills",
    "gemini-extension.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchtech/agent-warcraft.git"
  },
  "homepage": "https://mitchtech.github.io/agent-warcraft/",
  "bugs": "https://github.com/mitchtech/agent-warcraft/issues",
  "author": "Michael J. Mitchell <michael@mitchtech.net>",
  "license": "MIT",
  "keywords": [
    "warcraft",
    "peon",
    "orc",
    "audio",
    "notifications",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "gemini-cli-extension"
  ]
}
